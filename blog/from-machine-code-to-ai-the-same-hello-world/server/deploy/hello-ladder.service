[Unit]
Description=Hello World abstraction ladder runner (stephens.page blog)
After=network.target

[Service]
Type=simple
User=jacob
Group=jacob
WorkingDirectory=/var/www/stephens.page/blog/from-machine-code-to-ai-the-same-hello-world/server
ExecStart=/home/jacob/venvs/hello-ladder/bin/uvicorn app:app --host 127.0.0.1 --port 3521 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HELLO_LADDER_PATH=/home/jacob/.cargo/bin:/usr/local/go/bin:/usr/bin:/bin
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/www/stephens.page/blog/from-machine-code-to-ai-the-same-hello-world/cache
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M

[Install]
WantedBy=multi-user.target
